// ------------------------------------------------------------------
// Karachi Club Swimming Competition Management System - Prisma Schema
// ------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------

enum UserRole {
  PARTICIPANT // Swimmer with their own account
  PARENT      // Parent / guardian account managing one or more children
  COMMITTEE   // Committee member
}

enum Gender {
  MALE
  FEMALE
}

enum CompetitionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RegistrationStatus {
  REGISTERED
  CONFIRMED
  PENDING
  CANCELLED
}

enum Medal {
  GOLD
  SILVER
  BRONZE
  NONE
}

enum EventGenderType {
  MALE
  FEMALE
  MIXED
  OPEN
}

// ------------------------------------------------------------------
// Authentication (NextAuth models)
// ------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(PARTICIPANT)
  phone         String?
  committeeVerifiedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  participant Participant?
  parentChildren ParentChild[]

  uploadedDocuments Document[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String  @id @default(cuid())
  sessionToken String  @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ------------------------------------------------------------------
// Participant permanent profiles
// ------------------------------------------------------------------

model Participant {
  id                String   @id @default(cuid())
  fullName          String
  dateOfBirth       DateTime
  gender            Gender
  kcMembershipNumber String  @unique
  phone             String
  email             String?
  ageGroupId        String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  ageGroup AgeGroup? @relation(fields: [ageGroupId], references: [id], onDelete: SetNull)

  // Optional link when the swimmer has their own login
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  parentLinks ParentChild[]
  registrations Registration[]
  relayTeamMemberships RelayTeamMember[]
  results Result[]

  @@index([kcMembershipNumber])
  @@index([fullName])
  @@index([ageGroupId])
  @@map("participants")
}

// Relationship between a parent account and each of their children
model ParentChild {
  id            String       @id @default(cuid())
  parentUserId  String
  participantId String
  createdAt     DateTime     @default(now())

  parent      User        @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, participantId])
  @@map("parent_children")
}

// ------------------------------------------------------------------
// Strokes (base swimming stroke catalog)
// ------------------------------------------------------------------

model Stroke {
  id        String   @id @default(cuid())
  name      String   @unique // Freestyle, Backstroke, Breaststroke, Butterfly, Individual Medley
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  events Event[]

  @@map("strokes")
}

// ------------------------------------------------------------------
// Age groups (configurable by committee, no-code)
// ------------------------------------------------------------------

model AgeGroup {
  id        String   @id @default(cuid())
  name      String   // U-6, U-8 ... Open
  minAge    Int?
  maxAge    Int?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants Participant[]
  registrations Registration[]
  eventSlots    CompetitionEventAgeGroup[]
  results       Result[]

  @@index([sortOrder])
  @@map("age_groups")
}

// ------------------------------------------------------------------
// Events (global catalog) - distance + stroke + relay flag
// ------------------------------------------------------------------

model Event {
  id         String   @id @default(cuid())
  name       String   @unique // e.g. "50m Freestyle", "4x50m Medley Relay"
  distance   String   // stored as text for flexibility e.g. "50", "100", "4x50"
  isRelay    Boolean  @default(false)
  relaySwimmers Int?  // number of swimmers for relays (e.g. 4)
  genderType EventGenderType @default(OPEN)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  strokeId String?
  stroke   Stroke?  @relation(fields: [strokeId], references: [id], onDelete: SetNull)

  competitionEvents CompetitionEvent[]

  @@index([isActive])
  @@map("events")
}

// ------------------------------------------------------------------
// Competitions
// ------------------------------------------------------------------

model Competition {
  id                       String             @id @default(cuid())
  name                     String
  slug                     String             @unique
  description              String?
  date                     DateTime
  venue                    String?
  registrationOpensAt      DateTime?
  registrationClosesAt     DateTime?
  registrationEnabled      Boolean            @default(false)
  maxEventsPerParticipant  Int?
  status                   CompetitionStatus  @default(DRAFT)
  image                    String?            // poster image path in public/images/events/<slug>/
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  rules        CompetitionRule[]
  events       CompetitionEvent[]
  registrations Registration[]
  images       CompetitionImage[]
  results      Result[]
  documents    Document[]

  @@index([status])
  @@index([date])
  @@map("competitions")
}

model CompetitionRule {
  id            String   @id @default(cuid())
  competitionId String
  title         String?
  content       String
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId])
  @@map("competition_rules")
}

// Competition-specific event: which events are available per competition,
// their enabled state, ordering and eligible age groups / limits
model CompetitionEvent {
  id             String   @id @default(cuid())
  competitionId  String
  eventId        String
  isEnabled      Boolean  @default(true)
  sortOrder      Int      @default(0)
  maxParticipants Int?    // optional per-event limit
  heatCount      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  ageGroups     CompetitionEventAgeGroup[]
  registrations RegistrationEvent[]
  results       Result[]

  @@unique([competitionId, eventId])
  @@index([competitionId])
  @@map("competition_events")
}

// Eligibility: an age group allowed to enter a specific competition event
model CompetitionEventAgeGroup {
  competitionEventId String
  ageGroupId         String

  competitionEvent CompetitionEvent @relation(fields: [competitionEventId], references: [id], onDelete: Cascade)
  ageGroup         AgeGroup         @relation(fields: [ageGroupId], references: [id], onDelete: Cascade)

  @@id([competitionEventId, ageGroupId])
  @@map("competition_event_age_groups")
}

// Gallery images for a competition
model CompetitionImage {
  id            String   @id @default(cuid())
  competitionId String
  path          String   // path to image file e.g. /images/events/championship-2026/photo1.jpg
  altText       String?
  caption       String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId])
  @@map("competition_images")
}

// ------------------------------------------------------------------
// Registrations
// ------------------------------------------------------------------

model Registration {
  id            String             @id @default(cuid())
  competitionId String
  participantId String
  ageGroupId    String?

  status       RegistrationStatus @default(REGISTERED)
  registeredAt DateTime           @default(now())
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  ageGroup    AgeGroup?   @relation(fields: [ageGroupId], references: [id], onDelete: SetNull)

  events  RegistrationEvent[]
  results Result[]

  // Prevent duplicate registrations at the database level
  @@unique([competitionId, participantId])
  @@index([competitionId])
  @@index([participantId])
  @@map("registrations")
}

model RegistrationEvent {
  id                 String   @id @default(cuid())
  registrationId     String
  competitionEventId String
  relayTeamId        String?
  createdAt          DateTime @default(now())

  registration      Registration      @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  competitionEvent  CompetitionEvent  @relation(fields: [competitionEventId], references: [id], onDelete: Cascade)
  relayTeam         RelayTeam?        @relation(fields: [relayTeamId], references: [id], onDelete: SetNull)

  @@unique([registrationId, competitionEventId])
  @@index([competitionEventId])
  @@map("registration_events")
}

// ------------------------------------------------------------------
// Relay teams
// ------------------------------------------------------------------

model RelayTeam {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  registrationEvents RegistrationEvent[]
  members            RelayTeamMember[]
  results            Result[]
}

model RelayTeamMember {
  id         String    @id @default(cuid())
  relayTeamId String
  participantId String?
  fullName   String
  kcMembershipNumber String?
  phone      String?

  relayTeam   RelayTeam    @relation(fields: [relayTeamId], references: [id], onDelete: Cascade)
  participant Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([relayTeamId])
  @@map("relay_team_members")
}

// ------------------------------------------------------------------
// Results
// ------------------------------------------------------------------

model Result {
  id                 String   @id @default(cuid())
  competitionId      String
  competitionEventId String
  ageGroupId         String?

  registrationId String?
  participantId  String?
  relayTeamId    String?

  time      String?
  position  Int?
  medal     Medal    @default(NONE)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competition      Competition      @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  competitionEvent CompetitionEvent @relation(fields: [competitionEventId], references: [id], onDelete: Cascade)
  ageGroup         AgeGroup?        @relation(fields: [ageGroupId], references: [id], onDelete: SetNull)
  registration     Registration?    @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  participant      Participant?     @relation(fields: [participantId], references: [id], onDelete: SetNull)
  relayTeam        RelayTeam?       @relation(fields: [relayTeamId], references: [id], onDelete: SetNull)

  @@index([competitionId])
  @@index([competitionEventId])
  @@index([ageGroupId])
  @@map("results")
}

// ------------------------------------------------------------------
// Committee documents (private)
// ------------------------------------------------------------------

model Document {
  id            String   @id @default(cuid())
  name          String
  description   String?
  category      String?
  competitionId String?
  fileName      String
  filePath      String   // stored outside public folder
  mimeType      String
  size          Int
  uploadedById  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  uploadedBy User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([competitionId])
  @@index([category])
  @@map("documents")
}